extends layout

block content
  include includes/nav.pug
  div(class='reviews')
    div(class='text-entry')
      h3 Leave us a review below!
      form(method='POST' action='/create')
        span
          label(for='review') Subject:
          input(type='text', name='review', id='review', required)
        textarea(rows="6", cols="45", name='review_body', id='review_body', required)
        button(type='submit', class='submit') Submit
    hr
    div(class='posted-reviews')
      h2 Reviews:
      ul
      each val in reviews
        li
          span
            strong= val.review
            span(class="date")= val.date
          br
          if val.id == editId
            div(class='text-entry')
              form(method='POST' action='/update')
                span
                  input(type='hidden', name='id', value=val.id)
                  label(for='review') Subject:
                  input(type='text', name='review', id='review', required, value=val.review)
                textarea(rows="6", cols="45", name='review_body', id='review_body', required)= val.review_body
                button(type='submit', class='submit') Save
          else
            span= val.review_body
          div(class="button")
            form(method='POST' action='/delete')
              input(type='hidden', name='id', value=val.id)
              button(type='submit', class='delete') Delete
            form(method='POST' action='/edit')
              input(type='hidden', name='id', value=val.id)
              button(type='submit', class='edit') Edit